# Public-only Git history: reject accidental additions by default.
# This is a defense-in-depth convenience, not an access-control mechanism.
# Publishing is still subject to human review and explicit git add paths.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/*.md
!/.github/ISSUE_TEMPLATE/config.yml
!/.github/PULL_REQUEST_TEMPLATE.md
!/README.md
!/SECURITY.md
!/RELEASE_POLICY.md
!/CONTRIBUTING.md
!/docs/
!/docs/*.md
